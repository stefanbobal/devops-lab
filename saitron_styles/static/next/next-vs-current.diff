+/* =====================================================================================================
+   Next level (design export 2026-11): styles for the markup of next/urls.js and, in the first block,
+   the pieces next/certs.js shares (certs already loads this file for url-cnt and url-kind).
+   Variables only, so all four themes work. Newer features degrade without harm: see each note.
+   ===================================================================================================== */
+
+/* ----- shared by both panes ----- */
+.chk-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.chk-svg { width: 1.15em; height: 1.15em; flex: none; fill: none; stroke: currentColor; stroke-width: 1.75;
+  stroke-linecap: round; stroke-linejoin: round; vertical-align: -.2em; }
+/* <search> is new enough that an old browser treats it as an unknown inline element */
+search.chk-toolbar { display: flex; }
+
+/* pane header: the chip and the buttons stay on one line; the title block is what wraps */
+:is([data-pane="certs"], [data-pane="urls"]) .mon-main-head > div { min-width: 0; }
+:is([data-pane="certs"], [data-pane="urls"]) .mon-main-head .rhs { display: inline-flex; align-items: center; gap: .4rem; flex: none; }
+
+/* The panes are query containers: layout can follow the panel width instead of the window. */
+[data-pane="certs"], [data-pane="urls"] { container: panel / inline-size; }
+
+/* View Transitions: the JS marks what keeps its identity across renders (data-vt), CSS opts it in.
+   Typed attr() reads the name; a browser without it simply cross-fades the whole pane. */
+[data-vt] { view-transition-name: attr(data-vt type(<custom-ident>), none); view-transition-class: mon-card; }
+/* a card that changes height is clipped while it morphs, not stretched */
+::view-transition-old(.mon-card), ::view-transition-new(.mon-card) { height: 100%; object-fit: none; object-position: left top; overflow: clip; }
+
+/* "last scan / last check" chip: the age state is a dot, and "overdue" / "stale" are also written out */
+.chk-last[data-age]::before { content: ""; display: inline-block; width: .5rem; height: .5rem; margin-right: .4rem;
+  border-radius: 50%; background: var(--muted); }
+.chk-last[data-age="fresh"]::before { background: var(--ok); }
+.chk-last[data-age="late"]::before { background: var(--warn); }
+.chk-last[data-age="stale"]::before { background: var(--err); }
+.chk-ago { color: var(--muted); }
+.chk-age-word { font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; }
+.chk-last[data-age="late"] .chk-age-word { color: var(--warn); }
+.chk-last[data-age="stale"] .chk-age-word { color: var(--err); }
