+.kpi[data-tone="err"]:not([data-zero]) .k-val { color: var(--err); }
+.kpi[data-tone="warn"]:not([data-zero]) { border-color: var(--warn); }
+.kpi[data-tone="warn"]:not([data-zero]) .k-val { color: var(--warn); }
+/* unknown is never calm: a dashed edge, not a coloured one */
+.kpi[data-tone="unk"]:not([data-zero]) { border-style: dashed; border-color: var(--muted); }
+.kpi[data-zero] .k-val { color: var(--muted); }
