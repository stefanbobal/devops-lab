# Copy to .env and fill in. The .env file is git-ignored.
# On Cloud Run, set the same names as environment variables from Secret Manager.

# --- Jira (self-hosted, REST API v2) ---
JIRA_BASE_URL=https://jira.example.internal
# Personal access token of the dedicated technical Jira user
JIRA_TOKEN=
JIRA_PROJECT=CERT
JIRA_ISSUE_TYPE=Task
# A person approves an install by moving the ticket to one of these statuses
JIRA_APPROVED_STATUSES=Approved
# Workflow transition that closes the ticket after a verified install. Empty: leave it open.
JIRA_DONE_TRANSITION=Done
# CA bundle to verify the Jira server certificate. Empty: system trust store.
JIRA_CA_BUNDLE=

# --- Agent ---
# Secret that signs the metadata file on each ticket, so nobody can redirect an install.
# Create one with: python -c "import secrets; print(secrets.token_hex(32))"
CERT_AGENT_HMAC_KEY=
# PEM file with the CA certificates that are allowed to issue our certificates.
# Relative paths are relative to this folder.
CERT_AGENT_TRUSTED_CAS=trusted_cas.pem
CERT_AGENT_INVENTORY=inventory.yaml
CERT_AGENT_WORK_DIR=results
# A new certificate must be valid at least this many days
CERT_AGENT_MIN_VALID_DAYS=30
# After an install: how long to wait for the new certificate to be served, and how often to look
CERT_AGENT_VERIFY_TIMEOUT=300
CERT_AGENT_VERIFY_INTERVAL=15

# --- Passwords named by password_env in the inventory ---
ABAP_SANDBOX_PASSWORD=
NWA_SANDBOX_PASSWORD=

# --- MCP server ---
# stdio (default) or streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
