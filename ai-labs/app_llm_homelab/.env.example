# Copy to .env; use the SAME database/password as the working lab.
# Inside Docker use host=pgvector, not localhost or 127.0.0.1.
LLM_EVAL_PG_DSN=host=pgvector port=5432 dbname=postgres user=postgres password=REPLACE_WITH_EXISTING_LAB_PASSWORD
LAB_REVIEWER=sapops
# Relative to this compose file, or an absolute path on the Ubuntu VM.
LLM_RESULTS_DIR=../code/results
# Optional separate judge worker; calls Windows Ollama, no cloud API fees.
JUDGE_OLLAMA_HOST=http://192.168.178.25:11434
JUDGE_MODEL=gemma3:27b
# Worker reads existing cloud credentials from this dotenv file (app never receives it).
JUDGE_CLOUD_ENV_FILE=../code/.env
# Google ADC directory is mounted read-only into /gcp; defaults to ${HOME}/.config/gcloud.
# GCP_ADC_DIR=/home/sapops/.config/gcloud
JUDGE_GOOGLE_CREDENTIALS=/gcp/application_default_credentials.json
