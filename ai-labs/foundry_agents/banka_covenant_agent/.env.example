# Copy to .env and fill in. .env is not committed. No passwords here:
# the password goes to PGPASSWORD in the shell and to the Foundry connection agent-secrets.
AZURE_PG_SERVER=<postgres-server-name>
AZURE_PG_RG=<resource-group-of-the-server>
AZURE_PG_HOST=<postgres-server-name>.postgres.database.azure.com
AZURE_PG_USER=<admin-login>
