# Copy to .env and replace the placeholders. .env is gitignored.
# Generate random values, e.g.:  python3 -c "import secrets; print(secrets.token_hex(24))"

# Admin key of the gateway (must start with sk-). Used only by admin scripts, never by apps.
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Encrypts credentials LiteLLM stores in its DB. Do not change it after first start.
LITELLM_SALT_KEY=sk-CHANGE_ME

# Separate database "litellm" with its own role on the existing PostgreSQL server.
LITELLM_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://litellm:CHANGE_ME@pgvector:5432/litellm

# Ollama on the Windows host (OLLAMA_HOST=0.0.0.0 and a firewall rule for 11434 required).
OLLAMA_API_BASE=http://192.168.178.25:11434

# INFO for the lab, ERROR in production.
LITELLM_LOG=INFO
